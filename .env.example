# Copy to .env and fill in real values. The process will REFUSE TO BOOT
# (see app/config.py) if any of these are missing, empty, or match a known
# placeholder pattern (e.g. containing "changeme", "your-super-secret", etc).
ENVIRONMENT=development
SERVICE_NAME=calling-agent
LOG_LEVEL=INFO

# Postgres connection string the RUNNING SERVICE uses for all request
# traffic. In staging/production this MUST be the RLS-restricted
# `calling_agent_app` role from the baseline migration (never the role that
# owns the tables) — storage/db.py fails closed at connect time if it isn't
# (see docs/PHASE0_AUDIT.md Finding 1). In local dev / CI, a single
# superuser role is fine and this check is skipped (require sslmode=require
# or verify-full in staging/prod).
DATABASE_URL=postgresql+psycopg://calling_agent_app:password@host:5432/dbname

# OPTIONAL. A separate, more-privileged DSN used ONLY by Alembic to run DDL
# (CREATE TABLE, ALTER TABLE ... FORCE ROW LEVEL SECURITY, role grants) —
# calling_agent_app doesn't have those grants by design. If unset, Alembic
# falls back to DATABASE_URL, which is fine for a single-role local/CI
# setup but must be set explicitly in staging/production.
DATABASE_MIGRATION_URL=

# OPTIONAL. The narrow, SELECT-only, cross-organization role
# (calling_agent_worker) the worker runtime's reaper/reconciliation
# sweeps use to look up which org a bare attempt_id (from the Redis
# queue) belongs to, before it can open an org-scoped session for that
# org — DATABASE_URL's RLS-restricted role cannot do this by design (see
# docs/PHASE1_DESIGN.md). If unset, falls back to DATABASE_URL, fine for
# a single-role local/CI setup; must be set explicitly in
# staging/production, and must NEVER be DATABASE_MIGRATION_URL's role.
DATABASE_WORKER_URL=

# Redis connection string (use rediss:// with TLS in staging/prod)
REDIS_URL=redis://host:6379/0

# RS256 keypair, PEM format, used to sign/verify JWTs. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   openssl rsa -pubout -in jwt_private.pem -out jwt_public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# HMAC secret used to sign outbound webhooks to LeadBoost (TRD Part 3.5 / 5.4)
WEBHOOK_HMAC_SECRET=generate-with-python-secrets-token_urlsafe-32

# Vendor keys - required (and placeholder-checked) once ENVIRONMENT=production
EXOTEL_API_KEY=
DEEPGRAM_API_KEY=
GROQ_API_KEY=

REQUIRE_TLS_DB=true
REQUIRE_TLS_REDIS=true
